{
  "name": "starlight-file-explorer-monorepo",
  "version": "0.0.1",
  "license": "MIT",
  "description": "Explore and document files and folders in your Starlight site with an interactive file explorer.",
  "author": "HiDeoo <github@hideoo.dev> (https://hideoo.dev)",
  "type": "module",
  "scripts": {
    "test": "pnpm --stream -r test",
    "lint": "astro check --noSync && pnpm -r lint",
    "format": "prettier -w --cache --ignore-unknown .",
    "version": "pnpm changeset version && pnpm i --no-frozen-lockfile"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@hideoo/eslint-config": "^5.2.1",
    "@hideoo/prettier-config": "^2.0.2",
    "@hideoo/tsconfig": "^2.0.4",
    "astro": "^7.3.3",
    "eslint": "^10.11.0",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.1",
    "typescript": "^6.0.3"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.12.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    }
  },
  "private": true,
  "sideEffects": false,
  "keywords": [
    "// TODO(HiDeoo)"
  ],
  "homepage": "https://github.com/HiDeoo/starlight-file-explorer",
  "repository": {
    "type": "git",
    "url": "https://github.com/HiDeoo/starlight-file-explorer.git"
  },
  "bugs": "https://github.com/HiDeoo/starlight-file-explorer/issues"
}
