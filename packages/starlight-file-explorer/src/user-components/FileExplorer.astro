---
import type { APIContext } from 'astro'
import { AstroError } from 'astro/errors'

import Tree from '../components/Tree.astro'
import { processEntries } from '../libs/entries'

// TODO(HiDeoo) jsdoc
interface Props {
  label: string
}

const { label } = Astro.props

if (!label?.trim()) {
  throw new AstroError(
    'The `<FileExplorer>` component expects a non-empty `label` prop.',
    'Set a non-empty `label` prop on the `<FileExplorer>` component to describe its file tree to assistive technologies, e.g. `<FileExplorer label="Project files">`.',
  )
}

const instanceSymbol = Symbol.for('starlight-file-explorer:instance')

// https://github.com/withastro/starlight/blob/5a50fd103d4faf1d00592aa520b12e855fe940d7/packages/starlight/src/user-components/Tabs.astro#L11-L49
const locals = Astro.locals as APIContext['locals'] & { [instanceSymbol]?: number }
locals[instanceSymbol] ??= 0
const instance = locals[instanceSymbol]++

const html = await Astro.slots.render('default')
const { list, selected, tree } = processEntries(html, instance)
---

<starlight-file-explorer>
  <div class="sfe-explorer">
    <ul role="tree" aria-label={label} class="sfe-tree not-content">
      <Tree entries={tree} selected={selected.id} />
    </ul>
    <div class="sfe-panels">
      {list.map((entry) => (
        <div class="sfe-panel" hidden={entry !== selected} id={entry.id}>
          <div class="not-content">
            {entry.name}
            {entry.description && <p>{entry.description}</p>}
          </div>
          <Fragment set:html={entry.content} />
        </div>
      ))}
    </div>
  </div>
</starlight-file-explorer>

<style>
  starlight-file-explorer {
    container-type: inline-size;
    display: block;
  }

  .sfe-explorer {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .sfe-tree {
    border: 1px solid red;
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-xs);
    list-style: none;
    padding: 0;
  }

  .sfe-panels,
  .sfe-panel {
    border: 1px solid blue;
    margin-top: 0;
  }

  @container (min-width: 36rem) {
    .sfe-explorer {
      grid-template-columns: auto minmax(0, 1fr);
    }
  }
</style>

<script>
  // https://www.w3.org/WAI/ARIA/apg/patterns/treeview/examples/treeview-1a/
  customElements.define(
    'starlight-file-explorer',
    class StarlightFileExplorer extends HTMLElement {
      #selected: HTMLElement | undefined
      #walker = document.createTreeWalker(this, NodeFilter.SHOW_ELEMENT, (node) => {
        if (!(node instanceof HTMLElement)) return NodeFilter.FILTER_SKIP

        const role = node.getAttribute('role')

        if (role === 'treeitem') return NodeFilter.FILTER_ACCEPT
        if (role === 'group' && node.parentElement?.getAttribute('aria-expanded') === 'false') {
          return NodeFilter.FILTER_REJECT
        }

        return NodeFilter.FILTER_SKIP
      })

      constructor() {
        super()

        const state = this.querySelector('[aria-selected="true"]')
        if (state instanceof HTMLElement) this.#selected = state

        this.addEventListener('click', this.#handleClick)
        this.addEventListener('keydown', this.#handleKeydown)
      }

      #handleClick = (event: MouseEvent) => {
        if (!(event.target instanceof Element)) return

        const item = event.target.closest<HTMLElement>('[role="treeitem"]')
        if (!item) return

        if (event.target.closest('.sfe-tree-toggle')) {
          this.#setExpanded(item, item.getAttribute('aria-expanded') !== 'true')
        } else if (event.target.closest('.sfe-tree-row')) {
          this.#setSelected(item)
          this.#setExpanded(item, true)
        }
      }

      #handleKeydown = (event: KeyboardEvent) => {
        if (!(event.target instanceof Element)) return
        if (event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return

        const item = event.target.closest<HTMLElement>('[role="treeitem"]')
        if (!item) return

        this.#walker.currentNode = item
        const isExpanded = item.getAttribute('aria-expanded') === 'true'

        switch (event.key) {
          case 'ArrowDown':
            this.#setSelected(this.#walker.nextNode())
            break
          case 'ArrowUp':
            this.#setSelected(this.#walker.previousNode())
            break
          case 'ArrowRight':
            if (isExpanded) this.#setSelected(this.#walker.nextNode())
            else this.#setExpanded(item, true)
            break
          case 'ArrowLeft':
            if (isExpanded) this.#setExpanded(item, false)
            else this.#setSelected(this.#walker.parentNode())
            break
          case 'Home':
            this.#walker.currentNode = this
            this.#setSelected(this.#walker.firstChild())
            break
          case 'End': {
            this.#walker.currentNode = this.querySelector('.sfe-panels') ?? this
            this.#setSelected(this.#walker.previousNode())
            break
          }
          case 'Enter':
          case ' ': {
            this.#setExpanded(item, !isExpanded)
            break
          }
          default: {
            return
          }
        }

        event.preventDefault()
      }

      #setExpanded(item: HTMLElement, expanded: boolean) {
        if (item.hasAttribute('aria-expanded')) item.setAttribute('aria-expanded', String(expanded))
      }

      #setSelected(item: Node | null | undefined) {
        if (!(item instanceof HTMLElement)) return

        if (this.#selected) {
          this.#selected.tabIndex = -1
          this.#selected.setAttribute('aria-selected', 'false')
          this.#getPanel(this.#selected)?.setAttribute('hidden', '')
        }

        item.tabIndex = 0
        item.setAttribute('aria-selected', 'true')
        this.#getPanel(item)?.removeAttribute('hidden')

        item.focus()

        this.#selected = item
      }

      #getPanel(item: HTMLElement) {
        return document.getElementById(item.dataset['panel'] ?? '')
      }
    },
  )
</script>
