---
import { EntryTagName } from '../libs/entries'

// TODO(HiDeoo) JSDoc
// TODO(HiDeoo) shared with file
interface Props {
  collapsed?: boolean
  // TODO(HiDeoo) validation
  name: string
  selected?: boolean
}

const { collapsed, name, selected } = Astro.props
---

<EntryTagName
  data-type="folder"
  data-collapsed={collapsed || undefined}
  data-name={name}
  data-selected={selected || undefined}
>
  <slot />
</EntryTagName>
