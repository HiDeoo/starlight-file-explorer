---
import { EntryTagName, type EntryProps } from '../libs/entries'

// TODO(HiDeoo) JSDoc
interface Props extends EntryProps {
  collapsed?: boolean
}

const { collapsed, description, name, selected } = Astro.props
---

<EntryTagName
  data-type="folder"
  data-collapsed={collapsed || undefined}
  data-description={description}
  data-name={name}
  data-selected={selected || undefined}
>
  <slot />
</EntryTagName>
