---
import { Icon } from '@astrojs/starlight/components'

import type { Entry } from '../libs/entries'

interface Props {
  entries: Entry[]
  selected: string
}

const { entries, selected } = Astro.props
---

{entries.map((entry) => {
  const isFolder = entry.type === 'folder'
  const isFolderWithEntries = isFolder && entry.children.length > 0
  const isSelected = entry.id === selected

  return (
    <li
      aria-expanded={isFolderWithEntries ? !entry.collapsed : undefined}
      aria-selected={isSelected}
      class="sfe-tree-item"
      data-panel={entry.id}
      role="treeitem"
      tabindex={isSelected ? 0 : -1}
    >
      {isFolderWithEntries && <Icon name="right-caret" class="sfe-tree-toggle" />}
      <span class="sfe-tree-label">{entry.name}</span>
      {isFolderWithEntries && (
        <ul role="group">
          <Astro.self entries={entry.children} {selected} />
        </ul>
      )}
    </li>
  )
})}

<style>
  .sfe-tree-item {
    &[aria-expanded='false'] > [role='group'] {
      display: none;
    }

    &[aria-selected='true'] {
      border: 1px solid green;
    }
  }
</style>
